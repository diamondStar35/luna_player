#~ msgid "Low"
#~ msgstr "Baja"

#~ msgid "Medium"
#~ msgstr "Media"

#~ msgid "Best"
#~ msgstr "La mejor"

#~ msgid "Use yt-dlp to resolve streams"
#~ msgstr "Usar yt-dlp para resolver transmisiones"

