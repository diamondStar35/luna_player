"No se pudo guardar la selección.\n"
"\n"
"{error}"

#: Application/Commands/Playback/SelectionSaving.cs:131
msgid "Saved {saved} of {total} selection file."
msgid_plural "Saved {saved} of {total} selection files."
msgstr[0] "Se guardó {saved} de {total} archivo de selección."
msgstr[1] "Se guardaron {saved} de {total} archivos de selección."

#. Translators: Title of the confirmation after all selection points were saved.
#: Application/Commands/Playback/SelectionSaving.cs:141
msgid "Selections saved"
msgstr "Selecciones guardadas"

#. Translators: Heading for one selection that could not be saved. {number} is its slot number
