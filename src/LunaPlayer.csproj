<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>LunaPlayer</AssemblyName>
    <RootNamespace>LunaPlayer</RootNamespace>
    <Version>0.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The version resource Windows shows for the executable. AssemblyName is the file name and stays
         one word; these are what a person reads, and they are mirrored by ApplicationInfo. -->
    <Product>Luna Player</Product>
    <AssemblyTitle>Luna Player</AssemblyTitle>
    <Company>diamondStar35</Company>
    <Copyright>Licensed under the Apache License 2.0</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <!-- app.manifest is an input template. The build writes the manifest it embeds under obj after
         replacing its Win32 identity with the numeric AssemblyVersion derived from Version. -->
    <ApplicationManifest>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\LunaPlayer.generated.manifest</ApplicationManifest>
    <ApplicationManifestTemplate>$(MSBuildProjectDirectory)\app.manifest</ApplicationManifestTemplate>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);IL3050</NoWarn>
    <BaseOutputPath>$(BaseIntermediateOutputPath)managed\</BaseOutputPath>
    <NativeAotOutputDirectory>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</NativeAotOutputDirectory>
    <UpdaterPublishDirectory>$(MSBuildProjectDirectory)\obj\updater\$(Configuration)\$(RuntimeIdentifier)\</UpdaterPublishDirectory>
    <PublishDir>$(NativeAotOutputDirectory)</PublishDir>
    <RunCommand>$(NativeAotOutputDirectory)LunaPlayer.exe</RunCommand>
    <RunWorkingDirectory>$(NativeAotOutputDirectory)</RunWorkingDirectory>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <StackTraceSupport>true</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ProjectReference>
      <SetConfiguration>Configuration=Release</SetConfiguration>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="NativeLibraryBootstrap.cs" />
    <Compile Include="Mpv.cs" />
    <Compile Include="Accessibility\**\*.cs" />
    <Compile Include="Actions\**\*.cs" />
    <Compile Include="Application\**\*.cs" />
    <Compile Include="Bookmarks\**\*.cs" />
    <Compile Include="Configuration\**\*.cs" />
    <Compile Include="Favorites\**\*.cs" />
    <Compile Include="Media\**\*.cs" />
    <Compile Include="Playback\**\*.cs" />
    <Compile Include="Playlist\**\*.cs" />
    <Compile Include="Recording\**\*.cs" />
    <Compile Include="Update\**\*.cs" />
    <Compile Include="UI\**\*.cs" />
    <Compile Include="YouTube\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YoutubeExplode" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\third-party\WxSharp\src\WxSharp\WxSharp.csproj">
      <AdditionalProperties>Configuration=$(Configuration)</AdditionalProperties>
    </ProjectReference>
    <!-- Built from source rather than taken from NuGet. The published 3.0.1 packages marshal their
         WAVEFORMATEX and WAVEHDR structures through [StructLayout] classes, which NativeAOT lays out
         differently from the runtime - so every WASAPI capture is refused as an unsupported format and
         WaveOut plays nothing at all. See docs\issues\ for both. -->
    <ProjectReference Include="..\third-party\NAudio\src\NAudio.Wasapi\NAudio.Wasapi.csproj">
      <AdditionalProperties>Configuration=$(Configuration)</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="..\third-party\NAudio\src\NAudio.Extras\NAudio.Extras.csproj">
      <AdditionalProperties>Configuration=$(Configuration)</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="Speech\PrismSharp.csproj">
      <AdditionalProperties>Configuration=$(Configuration)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(RepositoryRoot)third-party\*.dll"
             Link="lib\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepositoryRoot)third-party\ffmpeg.exe"
             Link="lib\ffmpeg.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepositoryRoot)third-party\WxSharp\third-party\Windows\lib\vc_x64_dll\wxbase333u_vc_x64.dll"
             Link="lib\wxbase333u_vc_x64.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- The compiled message catalogues, in the locale/<language>/LC_MESSAGES layout wx looks them up in.
         scripts\update-pot.ps1 builds them from the .po files; a build with none simply stays English. -->
    <Content Include="$(RepositoryRoot)locale\**\*.mo"
             Link="locale\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepositoryRoot)third-party\WxSharp\third-party\Windows\lib\vc_x64_dll\wxmsw333u_core_vc_x64.dll"
             Link="lib\wxmsw333u_core_vc_x64.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- The licence the player is published under, and the notices for the libraries it ships with.
         Two of those licences require their text to travel with the binaries they cover. -->
    <Content Include="$(RepositoryRoot)LICENSE"
             Link="LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepositoryRoot)NOTICE"
             Link="NOTICE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepositoryRoot)third-party\licenses\*"
             Link="licenses\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepositoryRoot)docs\**\*.html"
             Link="docs\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateVersionedWin32Manifest"
          BeforeTargets="SetWin32ManifestProperties"
          DependsOnTargets="PrepareForBuild;GetAssemblyVersion">
    <Copy SourceFiles="$(ApplicationManifestTemplate)"
          DestinationFiles="$(ApplicationManifest)" />
    <XmlPoke XmlInputPath="$(ApplicationManifest)"
             Query="/*[local-name()='assembly']/*[local-name()='assemblyIdentity']/@version"
             Value="$(AssemblyVersion)" />
    <ItemGroup>
      <FileWrites Include="$(ApplicationManifest)" />
    </ItemGroup>
  </Target>

  <Target Name="PublishNativeAotAfterBuild"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(_IsPublishing)' != 'true' and '$(NativeAotBuildInvocation)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);NativeAotBuildInvocation=true" />
  </Target>

  <Target Name="RenderDocumentation"
          BeforeTargets="Build;Publish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="python &quot;$(RepositoryRoot)docs\render_docs.py&quot;" />
  </Target>

  <!-- These dynamic globs matter on a clean checkout: generated HTML does not exist when MSBuild first
       evaluates the Content items above. Only the rendered files are copied; Markdown remains source-only. -->
  <Target Name="CopyDocumentationToOutput"
          AfterTargets="Build"
          DependsOnTargets="RenderDocumentation"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_RenderedDocumentation Include="$(RepositoryRoot)docs\**\*.html" />
    </ItemGroup>
    <Copy SourceFiles="@(_RenderedDocumentation)"
          DestinationFiles="@(_RenderedDocumentation->'$(OutDir)docs\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyDocumentationToPublish"
          AfterTargets="Publish"
          DependsOnTargets="RenderDocumentation"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishDir)' != ''">
    <ItemGroup>
      <_PublishedDocumentation Include="$(RepositoryRoot)docs\**\*.html" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishedDocumentation)"
          DestinationFiles="@(_PublishedDocumentation->'$(PublishDir)docs\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishUpdater"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- MSBuild's Publish target does not restore a project first. The updater is invoked directly rather
         than referenced by this project, so a clean release runner has no assets file until we do it here. -->
    <MSBuild Projects="$(RepositoryRoot)updater\Updater.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" />
    <MSBuild Projects="$(RepositoryRoot)updater\Updater.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishDir=$(UpdaterPublishDirectory)" />
    <Delete Files="$(NativeAotOutputDirectory)Updater.dll;$(NativeAotOutputDirectory)Updater.pdb;$(NativeAotOutputDirectory)Updater.runtimeconfig.json" />
    <Copy SourceFiles="$(UpdaterPublishDirectory)Updater.exe"
          DestinationFolder="$(NativeAotOutputDirectory)" />
  </Target>
</Project>
